<mxfile host="app.diagrams.net">
  <diagram name="第 1 页" id="a9tZWVjTCNVPRku96zmV">
    <mxGraphModel dx="5846" dy="3160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 流程图 2：下位机升级状态机及执行流程图 (Flowchart)\n    %% 可以在 https://mermaid.live/ 或 Draw.io 中导入和编辑\n    Start([系统复位启动]) --&gt; InitBoot[读取共享内存区参数 tBootMemParam]\n    InitBoot --&gt; ChkCmd{ulCmd 标志位?}\n    \n    ChkCmd -- \&quot;ulCmd == 0xAAAAAAAA (mainUPDATE_FLAG)\&quot; --&gt; TaskUpdate[进入升级任务 STI_UPDATE]\n    ChkCmd -- 其他标志或正常运行 --&gt; JumpAppDirect[跳转到 APP]\n    \n    TaskUpdate --&gt; StateIdle[\&quot;BAIKU_STATE_IDLE: 初始化百酷协议与显示\&quot;]\n    StateIdle --&gt; SetStandby[切换状态至 BAIKU_STATE_STANDBY]\n    \n    SetStandby --&gt; StandbyLoop[发送 NAK 0xC4 并检测串口数据]\n    StandbyLoop --&gt; RecDataCheck{接收到有效数据?}\n    \n    RecDataCheck -- \&quot;无数据 (60秒超时)\&quot; --&gt; TimeoutErr[\&quot;触发 v_rec_end_cd(2) 跳转或返回原APP\&quot;]\n    \n    RecDataCheck -- \&quot;0xC2 (baikuCMD_SET_PROTO)\&quot; --&gt; RecProto[\&quot;解析总帧数 TotalFrameCount 回复 0xC3\&quot;]\n    RecProto --&gt; StandbyLoop\n    \n    RecDataCheck -- \&quot;0xC5 (baikuCMD_REPLY_DATA) 且 SN==1\&quot; --&gt; FirstPacket[\&quot;执行 v_rec_start_cd() 擦除APP并设置写入地址为 flashAPP_START\&quot;]\n    FirstPacket --&gt; WriteFlash1[\&quot;调用 bFlash_WriteDataToFlash() 写入第一包数据 56 字节\&quot;]\n    WriteFlash1 --&gt; SetReceiving[\&quot;状态切至 BAIKU_STATE_RECEIVING 发送 ACK 0xC6 并期待 SN=2\&quot;]\n    \n    SetReceiving --&gt; RecvLoop[发送 ACK 0xC6 / NAK 0xC4 并检测串口]\n    RecvLoop --&gt; RecvCheck{接收到有效包?}\n    \n    RecvCheck -- \&quot;0xC5 且 SN == 期待帧号\&quot; --&gt; WriteFlashN[\&quot;写入 Flash (大小=224字节) 自增期待帧号 发送 ACK 0xC6\&quot;]\n    WriteFlashN --&gt; RecvLoop\n    \n    RecvCheck -- \&quot;0xC5 且 SN 不匹配\&quot; --&gt; ResendCheck[\&quot;错误包处理 发送 NAK 0xC4 触发重传\&quot;]\n    ResendCheck --&gt; RecvLoop\n    \n    RecvCheck -- \&quot;0xC7 (baikuCMD_REPLY_FINISH)\&quot; --&gt; SetFinish[\&quot;状态切至 BAIKU_STATE_FINISH 发送最后 ACK 0xC6\&quot;]\n    \n    RecvCheck -- \&quot;0xC8 (baikuCMD_REPLY_CANEL)\&quot; --&gt; SetCancel[\&quot;状态切至 BAIKU_STATE_CANCEL 终止升级\&quot;]\n    \n    SetFinish --&gt; RecEnd[\&quot;执行 v_rec_end_cd(0) 检查新APP栈顶指针并设置状态为 AS_FINISH\&quot;]\n    RecEnd --&gt; TaskEnterApp[进入进入 APP 任务 STI_ENTER_APP]\n    TaskEnterApp --&gt; JumpApp[\&quot;执行 cSys_JumpToApp() 跳转运行\&quot;]\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WbY0SlXVhwyzhZniBfcK-265">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
